generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USERS & AUTH
// ==========================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  nickname           String?            @unique
  password_hash      String?
  role               UserRole           @default(USER)
  verification_status VerificationStatus @default(UNVERIFIED)
  phone              String?
  platform           Platform?
  platform_user_id   String?
  display_name       String?
  preferred_currency String             @default("MXN")
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt

  sessions               Session[]
  verification_codes     VerificationCode[]
  fortnite_accounts      FortniteAccount[]
  requests               Request[]
  friendship_requests    FriendshipRequest[]
  notifications          Notification[]
  notification_prefs     NotificationPreference?
  payments               Payment[]
  cart_items             CartItem[]
  audit_logs             AuditLog[]

  @@index([email])
  @@index([nickname])
}

model Session {
  id           String   @id @default(uuid())
  user_id      String
  token        String   @unique
  refresh_token String  @unique
  expires_at   DateTime
  created_at   DateTime @default(now())
  user_agent   String?
  ip_address   String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
}

model VerificationCode {
  id         String   @id @default(uuid())
  user_id    String?
  email      String
  code       String
  attempts   Int      @default(0)
  expires_at DateTime
  verified   Boolean  @default(false)
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([code])
}

// ==========================================
// FORTNITE ACCOUNTS (User's linked accounts)
// ==========================================

enum Platform {
  EPIC
  XBOX
  PLAYSTATION
}

model FortniteAccount {
  id                  String            @id @default(uuid())
  user_id             String
  platform            Platform
  platform_user_id    String
  display_name        String?
  verification_status VerificationStatus @default(UNVERIFIED)
  created_at          DateTime          @default(now())
  updated_at          DateTime          @updatedAt

  user                User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@unique([user_id, platform])
}

// ==========================================
// CATALOG
// ==========================================

enum ProductType {
  OUTFIT
  BACK_BLING
  PICKAXE
  GLIDER
  EMOTE
  WRAP
  MUSIC_PACK
  LOADING_SCREEN
  SPRAY
  CONTRAIL
  TOY
  BANNER
  VBucks
  BATTLE_PASS
  CREW
  BUNDLE
  OTHER
}

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
  EXOTIC
  ICON_SERIES
  STAR_WARS
  DC
  MARVEL
  GAMING_LEGENDS
  LAVA
  FROZEN
  SHADOW
  SLURP
  DARK
  BRIGHT
  BEYOND
}

enum GiftabilityStatus {
  GIFTABLE
  NOT_GIFTABLE
  UNKNOWN
}

model Product {
  id                  String           @id @default(uuid())
  internal_sku        String           @unique
  fortnite_product_id String
  fortnite_offer_id   String?
  name                String
  slug                String           @unique
  description         String?
  type                ProductType
  subcategory         String?
  rarity              Rarity?
  series              String?
  price_vbucks        Int
  image_url           String?
  icon_url            String?
  featured_image_url  String?
  banner_url          String?
  giftable            GiftabilityStatus @default(UNKNOWN)
  active              Boolean          @default(true)
  visible             Boolean          @default(true)
  admin_price_mxn     Decimal?         @db.Decimal(10, 2)
  first_seen_at       DateTime?
  last_seen_at        DateTime?
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt

  shop_items          ShopItem[]
  request_items       RequestItem[]

  @@index([fortnite_product_id])
  @@index([type])
  @@index([slug])
  @@index([active, visible])
}

model ShopSnapshot {
  id          String   @id @default(uuid())
  provider    String
  fetched_at  DateTime
  shop_date   DateTime
  raw_payload Json
  checksum    String
  created_at  DateTime @default(now())

  shop_items  ShopItem[]

  @@index([fetched_at])
  @@index([shop_date])
}

model ShopItem {
  id               String   @id @default(uuid())
  shop_snapshot_id String
  product_id       String
  price_vbucks     Int
  display_order    Int      @default(0)
  section          String?
  featured         Boolean  @default(false)
  created_at       DateTime @default(now())

  shop_snapshot    ShopSnapshot @relation(fields: [shop_snapshot_id], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([shop_snapshot_id])
  @@index([product_id])
}

// ==========================================
// CART
// ==========================================

enum CartItemType {
  GIFT
  VBucks
  CREW
  BATTLE_PASS
}

model CartItem {
  id                    String      @id @default(uuid())
  user_id               String
  product_id            String
  quantity              Int         @default(1)
  type                  CartItemType
  encrypted_credentials Json?
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt

  user                  User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([user_id])
}

// ==========================================
// REQUESTS (Purchase Requests)
// ==========================================

enum RequestStatus {
  CREATED
  WHATSAPP_OPENED
  CONTACTED
  UNDER_REVIEW
  PRICE_CONFIRMED
  PAYMENT_PENDING
  PAID
  FULFILLMENT_PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

model Request {
  id              String        @id @default(uuid())
  request_number  String        @unique
  user_id         String
  status          RequestStatus @default(CREATED)
  channel         String?
  message         String?
  total_vbucks    Int           @default(0)
  total_mxn       Decimal       @default(0) @db.Decimal(10, 2)
  whatsapp_opened_at DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt

  user            User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items           RequestItem[]
  payments        Payment[]

  @@index([user_id])
  @@index([status])
  @@index([request_number])
  @@index([created_at])
}

model RequestItem {
  id                      String   @id @default(uuid())
  request_id              String
  product_id              String
  sku                     String
  product_name_snapshot   String
  fortnite_product_id     String
  fortnite_offer_id       String?
  price_vbucks_snapshot   Int
  quantity                Int      @default(1)
  fulfillment_type        String?
  created_at              DateTime @default(now())

  request                 Request  @relation(fields: [request_id], references: [id], onDelete: Cascade)
  product                 Product  @relation(fields: [product_id], references: [id])

  @@index([request_id])
}

// ==========================================
// PAYMENTS
// ==========================================

enum PaymentMethod {
  TRANSFER
  OXXO
}

enum PaymentStatus {
  PENDING_RECEIPT
  VALIDATION_IN_PROGRESS
  VALIDATED
  REJECTED
}

model Payment {
  id                 String        @id @default(uuid())
  request_id         String
  user_id            String
  method             PaymentMethod
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("MXN")
  receipt_file_url   String?
  receipt_file_name  String?
  status             PaymentStatus @default(PENDING_RECEIPT)
  admin_notes        String?
  validated_by       String?
  validated_at       DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  request            Request       @relation(fields: [request_id], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([request_id])
  @@index([user_id])
  @@index([status])
}

// ==========================================
// FULFILLMENT ACCOUNTS (Bots)
// ==========================================

enum BotStatus {
  ACTIVE
  COOLDOWN
  LIMITED
  UNAVAILABLE
  DISABLED
  ERROR
}

model FulfillmentAccount {
  id                  String    @id @default(uuid())
  name                String
  platform            Platform  @default(EPIC)
  status              BotStatus @default(ACTIVE)
  capacity            Int       @default(1000)
  daily_limit         Int       @default(50)
  current_usage       Int       @default(0)
  external_identifier String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  friendship_bots     FriendshipRequestBot[]

  @@index([status])
  @@index([platform])
}

// ==========================================
// FRIENDSHIP REQUESTS
// ==========================================

enum FriendshipRequestStatus {
  CREATED
  PROCESSING
  WAITING_ACCEPTANCE
  PARTIALLY_READY
  READY
  CANCELLED
}

model FriendshipRequest {
  id                String                  @id @default(uuid())
  request_id        String?                 @unique
  user_id           String
  platform          Platform
  platform_user_id  String
  status            FriendshipRequestStatus @default(CREATED)
  required_bots     Int                     @default(1)
  created_at        DateTime                @default(now())
  updated_at        DateTime                @updatedAt

  user              User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bots              FriendshipRequestBot[]

  @@index([user_id])
  @@index([status])
  @@index([request_id])
}

enum BotRequestStatus {
  PENDING
  REQUEST_SENT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNKNOWN
}

model FriendshipRequestBot {
  id                      String           @id @default(uuid())
  friendship_request_id   String
  fulfillment_account_id  String
  request_status          BotRequestStatus @default(PENDING)
  friendship_status       FriendshipStatus @default(PENDING)
  request_sent_at         DateTime?
  friendship_confirmed_at DateTime?
  eligibility_at          DateTime?
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt

  friendship_request      FriendshipRequest @relation(fields: [friendship_request_id], references: [id], onDelete: Cascade)
  fulfillment_account     FulfillmentAccount @relation(fields: [fulfillment_account_id], references: [id])

  @@index([friendship_request_id])
  @@index([fulfillment_account_id])
  @@index([friendship_status])
  @@index([eligibility_at])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id         String    @id @default(uuid())
  user_id    String
  type       String
  channel    String
  title      String
  message    String
  metadata   Json?
  read_at    DateTime?
  created_at DateTime  @default(now())

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([read_at])
  @@index([created_at])
}

model NotificationPreference {
  id               String   @id @default(uuid())
  user_id          String   @unique
  email_enabled    Boolean  @default(true)
  web_enabled      Boolean  @default(true)
  whatsapp_enabled Boolean  @default(true)
  updated_at       DateTime @updatedAt

  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ==========================================
// CURRENCY
// ==========================================

model ExchangeRate {
  id           String   @id @default(uuid())
  currency_code String  @unique
  rate_to_mxn  Decimal  @db.Decimal(12, 6)
  source       String?
  fetched_at   DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model CurrencySetting {
  id               String   @id @default(uuid())
  default_currency String  @default("MXN")
  vbucks_rate_mxn  Decimal @default(7.5) @db.Decimal(10, 4)
  updated_by       String?
  updated_at       DateTime @updatedAt
}

model SystemSetting {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt
}

// ==========================================
// EVENT LOG / AUDIT
// ==========================================

model EventLog {
  id         String   @id @default(uuid())
  entity     String
  entity_id  String
  event_type String
  user_id    String?
  metadata   Json?
  created_at DateTime @default(now())

  @@index([entity, entity_id])
  @@index([event_type])
  @@index([created_at])
}

model AuditLog {
  id         String   @id @default(uuid())
  admin_id   String
  action     String
  entity     String
  entity_id  String
  metadata   Json?
  created_at DateTime @default(now())

  admin      User     @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([admin_id])
  @@index([entity, entity_id])
  @@index([created_at])
}
