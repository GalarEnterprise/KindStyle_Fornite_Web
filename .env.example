# Database
DATABASE_URL=postgresql://kindstyle:kindstyle_dev@localhost:5432/kindstyle_dev

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@kindstyle.com

# Fortnite API (Legacy - fortnite-api.com)
# Puede usarse FORTNITE_API_KEY/FORTNITE_API_URL o sus alias LEGACY_*.
FORTNITE_API_KEY=your_fortnite_api_key
FORTNITE_API_URL=https://fortnite-api.com
LEGACY_FORTNITE_API_KEY=your_fortnite_api_key
LEGACY_FORNITE_URL=https://fortnite-api.com

# Fortnite API (New - api-fortnite.com)
# La URL base DEBE ser https://prod.api-fortnite.com/api (no https://api-fortnite.com)
API_FORTNITE_API_KEY=your_api_fortnite_api_key
API_FORNITE_URL=https://prod.api-fortnite.com/api

# Catalog Provider Selection (legacy | api-fortnite)
CATALOG_PROVIDER=legacy

# Shadow Mode (compare both providers)
CATALOG_SHADOW=false

# Encryption (for user credentials)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=+523531022207

# Mock mode
MOCK_FORTNITE=false
MOCK_FULFILLMENT=false

# Payment info (displayed to users)
PAYMENT_CLABE=722969040853088360
PAYMENT_OXXO_ACCOUNT=4217470331487708
PAYMENT_BENEFICIARY=Lidia Isela Perez R.
